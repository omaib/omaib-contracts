{
  "adapter_id": "dap-synthetic-demo",
  "benchmark_id": "omaib-synthetic-demo",
  "version": "0.1.0",
  "formats": ["parquet", "jsonl"],
  "provenance_fields": ["source", "generation_timestamp", "seed", "checksum"],
  "alignment": {
    "time_reference": "N/A (synthetic — no temporal alignment needed)",
    "sync_tolerance_ms": null
  },
  "missingness": {
    "mask_field": "missing_mask",
    "quality_flags_field": "quality_flags"
  },
  "modalities": ["tabular", "text"],
  "sample_unit": "One row in the parquet file = one sample with all modality columns present",
  "splits": {
    "strategy": "random stratified",
    "ratios": { "train": 0.7, "val": 0.15, "test": 0.15 },
    "leakage_controls": [
      "no sample overlap across splits",
      "stratified by target class"
    ]
  },
  "size_estimate": {
    "samples": 10000,
    "storage_gb": 0.05,
    "duration_hours": null
  }
}
