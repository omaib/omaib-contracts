{
  "adapter_id": "dap-synthetic-demo",
  "benchmark_id": "omaib-synthetic-demo",
  "version": "0.1.0",
  "formats": ["wav", "csv"],
  "provenance_fields": [
    "source",
    "collection_timestamp",
    "site",
    "sensor_id",
    "checksum"
  ],
  "alignment": {
    "time_reference": "<UTC | GPS | NTP | N/A>",
    "sync_tolerance_ms": null
  },
  "missingness": {
    "mask_field": "missing_mask",
    "quality_flags_field": "quality_flags"
  },
  "modalities": ["audio", "tabular"],
  "sample_unit": "1 recording session from a single microphone array",
  "splits": {
    "strategy": "temporal",
    "ratios": { "train": 0.7, "val": 0.15, "test": 0.15 },
    "leakage_controls": ["No overlap between recording dates across splits"]
  },
  "size_estimate": {
    "samples": 12000,
    "storage_gb": 45.0,
    "duration_hours": null
  }
}
