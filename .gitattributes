# Enforce LF line endings for all text files in this repository.
# This overrides core.autocrlf on Windows and ensures consistent
# line endings across all platforms (Linux CI, Mac, Windows developers).

* text=auto eol=lf

# Explicitly mark binary files so Git never converts them.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.whl  binary
