{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omaib.org/schemas/assurance-crosswalk/v0.1.json",
  "title": "OMAIB Assurance Crosswalk (v0.1)",
  "description": "Validates assurance_crosswalk.yaml files in Domain Adapter Packs (CDRF-Assure layer).",
  "type": "object",
  "required": ["adapter_id", "benchmark_id", "version"],
  "properties": {
    "adapter_id": { "type": "string", "pattern": "^dap-[a-z0-9-]+$" },
    "benchmark_id": { "type": "string", "pattern": "^omaib-[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "standards_targets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_field", "control_id"],
        "properties": {
          "evidence_field": { "type": "string" },
          "control_id": { "type": "string" },
          "standard": { "type": "string" },
          "gate": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "decision_gates": {
      "type": "object",
      "description": "Conditions for advancing from pilot → limited deployment → scale",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
